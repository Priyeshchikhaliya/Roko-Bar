{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/admin/blocked",
      "destination": "/api/admin/blocked/__collection"
    },
    {
      "source": "/((?!api/|src/|node_modules/|assets/|@|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
