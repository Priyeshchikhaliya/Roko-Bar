# Supabase project URL, for example:
# https://your-project-ref.supabase.co
SUPABASE_URL=

# Supabase service_role key.
# Keep this secret. It is for server-side API functions only and must never be
# exposed to the React client or committed with a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Shared admin password for /admin. Server-side only; never prefix with VITE_.
ADMIN_PASSWORD=

# Server-only tutor directory used for assignment and WhatsApp introductions.
# Only tutor names are exposed to authenticated admin clients.
TUTORS='[{"name":"Priyesh","wa":"491234567890"}]'

# Public site origin used in the links inside transactional emails. No trailing
# slash, no path. In Vercel Production this MUST be the live origin below —
# setting it to localhost there mails guests a link to their own device.
# Locally, override it in .env with http://localhost:3000.
SITE_URL=https://www.rokobar.de

# Resend API key for booking acknowledgement, approval, and confirmation emails.
RESEND_API_KEY=

# Shared secret for the daily deadline-reminder cron. Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>" on scheduled invocations. Required in
# Production: with no secret the endpoint refuses every caller, including
# Vercel's own cron, and guests silently stop receiving deadline reminders.
# Any long random string works, for example `openssl rand -hex 32`.
CRON_SECRET=

# Bank transfer details for rent payments. Use placeholders here only.
BANK_IBAN="DE00 0000 0000 0000 0000 00"
BANK_HOLDER="Example Account Holder"
BANK_NAME="Example Bank"
